{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "System": "Information",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console",
              "Args": {
                "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
                "outputTemplate": "{Timestamp:HH:mm:ss.ffffff}|{Level:u3}|{Message:lj}<:s{SourceContext}{NewLine}{Exception}",
                "restrictedToMinimumLevel": "Debug"
              }
            }
          ]
        }
      }
    ]
  },
  "MarketDataSourcesOptions": {
    "MarketDataDirectory": "/tmp/market-data-storage",
    "CacheDirectory": "/tmp/cache",
    "UseMmf": true
  },
  "StrategyOptions": {
    "Symbol": "BIGTIME@USDT.BinanceFutures",
    "TradeDate": "2025-06-01"
  },
  "MatcherSettings": {
    "PriceStep": "0.0001",
    "PointPrice": 1,
    "WarrantyCoverageLong": 1,
    "WarrantyCoverageShort": 1,
    "MakerFee": 0.0015,
    "TakerFee": 0.002
  }
}
