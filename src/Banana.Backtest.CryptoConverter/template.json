{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Async",
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Information",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console",
              "Args": {
                "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
                "outputTemplate": "{Timestamp:HH:mm:ss.ffffff}|{Level:u3}|{Message:lj}<:s{SourceContext}{NewLine}{Exception}"
              }
            },
            {
              "Name": "File",
              "Args": {
                "path": "D:/logs/log_.log",
                "rollingInterval": "Day"
              }
            },
            {
              "Name": "Elasticsearch",
              "Args": {
                "bootstrapMethod": "Failure",
                "nodes": ["http://192.168.88.213:9200"],
                "username": "elastic",
                "password": "Z10n0101",
                "includeHost": false,
                "includeActivity": false,
                "includeProcess": false,
                "includeUser": false,
                "dataStream": "logs-converter-crypto",
                "restrictedToMinimumLevel": "Debug"
              }
            }
          ]
        }
      }
    ]
  },
  "TardisHttpClientOptions": {
    "DatasetsUrl": "https://datasets.tardis.dev",
    "ApiUrl": "https://api.tardis.dev",
    "AccessToken": "",
    "HandlerLifetime": "01:00:00",
    "RateLimiter": {
      "DefaultRateLimiterOptions": {
        "PermitLimit": 32,
        "QueueLimit": 128,
        "QueueProcessingOrder": "OldestFirst"
      }
    },
    "Retry": {
      "BackoffType": "Linear",
      "Delay": "00:00:03",
      "MaxDelay": "00:05:00",
      "MaxRetryAttempts": 3
    },
    "AttemptTimeout": {
      "Timeout": "00:05:00"
    },
    "TotalRequestTimeout": {
      "Timeout": "00:15:00"
    },
    "CircuitBreaker": {
      "BreakDuration": "00:00:10",
      "SamplingDuration": "00:15:00"
    }
  },
  "ConverterOptions": {
    "RefreshInstrumentsScheduleCrone": "1 21 * * *",
    "DownloadScheduleCrone": "10 21 * * *",
    "Term": "-1",
    "HistoryDepth": "2024-01-01",
    "WorkersCount": 16,
    "MaxDegreeOfParallelismForSchedulers": 2,
    "ServerName": "banana-crypto-converter",
    "Exchanges": [
      "BinanceFutures",
      "OkexSwap",
      "KucoinFutures"
    ],
    "Queues": [
      "instrumetsrefresh",
      "convertexchange",
      "trades",
      "levelupdates",
      "instrumetsrefresh",
      "convertexchange"
    ]
  },
  "MarketDataParserOptions": {
    "OutputDirectory": "D:/market-data-storage",
    "CompressionType": "Brotli",
    "CompressionLevel": "Optimal"
  },
  "RedisOptions": {
    "ConnectionString": "192.168.88.213:26379,192.168.88.213:26380,192.168.88.213:26381",
    "ServiceName": "banana-cluster",
    "AbortOnConnectionFail": false,
    "ConnectTimeout": 15000,
    "SchedulerDatabase": 0,
    "CatalogDatabase": 1,
    "Password": "Z10n0101N#",
    "KeyPrefix": "banana.converter."
  }
}
